# Database Configuration for Neon PostgreSQL
# IMPORTANT: The code automatically converts direct connections to pooler connections
# for better scalability (supports 1000+ concurrent connections)

# Option 1: Direct host (will be auto-converted to pooler)
DB_HOST=ep-xxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=your-username
DB_PASSWORD=your-password
DB_NAME=your-database-name

# Option 2: Connection string (will be auto-converted to pooler if Neon)
# Direct connection (auto-converted):
# DATABASE_URL=postgresql://username:password@ep-xxx.neon.tech/database?sslmode=require
# 
# Or explicitly use pooler (recommended for high traffic):
# DATABASE_URL=postgresql://username:password@ep-xxx.pooler.neon.tech/database?sslmode=require

# Option 3: Explicitly use pooler host (recommended for 50+ concurrent users)
# DB_HOST=ep-xxx.pooler.neon.tech

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration
FRONTEND_URL=https://your-vercel-app.vercel.app

# QR Code Configuration
QR_CODE_SIZE=200
QR_CODE_MARGIN=2

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secure-jwt-secret-key-here
